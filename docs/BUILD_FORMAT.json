{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grim-weaver.invalid/build-v1.schema.json",
  "title": "GrimWeaver stable build extension contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "environment",
    "dataHashes",
    "skills",
    "equipment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "buildId": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string",
          "maxLength": 256
        },
        "idea": {
          "type": "string",
          "maxLength": 30000
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "modVersion": {
          "type": "string"
        },
        "gameVersion": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string"
        },
        "videoPath": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "compatibilityPolicy": {
    "codec": "DB1 gzip JSON base64url; prefix retained",
    "unknownFields": "Preserve verbatim through import, save, export and share",
    "datasetChanges": "Explicit migration; missing records must not be silently removed",
    "media": "Reference only; never auto-open imported media or embed video",
    "legacyFixtures": "v0.1, v1.0, v1.1, v1.2, v1.3, v1.4"
  }
}